# ── Dane ─────────────────────────────────────────────────────────────────────
# Surowe dane NIE są śledzone – pobierz ręcznie wg data/raw/ZRODLO.md
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/raw/*.parquet
# Przetworzone dane – generowane przez notebook 02
data/processed/*.csv
data/processed/*.parquet
# Zachowaj placeholder, żeby Git śledził pusty folder
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Wykresy i raporty ─────────────────────────────────────────────────────────
# Generowane przez notebooki – odtwarzalne przez run_all.py
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg
reports/figures/*.pdf
# Zachowaj placeholder
!reports/figures/.gitkeep
# Raport końcowy – śledź, gdy zostanie napisany
# reports/raport.pdf  <- odkomentuj gdy chcesz trzymać PDF w repo

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Środowiska wirtualne ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Narzędzia i IDE ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testy / cache ─────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Dystrybucja ───────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
